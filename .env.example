# Optional Bosta integration. Store credentials only in the Worker runtime.
# For Wrangler local testing, copy the needed values into an ignored .dev.vars.
# Hosted Sites values are configured in its runtime settings, not in this file.
BOSTA_API_KEY=
BOSTA_WEBHOOK_SECRET=
BOSTA_ENABLED=false

# DB (Cloudflare D1) and BUCKET (Cloudflare R2) are bindings, not environment strings.
# A normal local catalogue/checkout preview needs no Bosta credentials.
